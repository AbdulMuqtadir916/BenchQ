# Backend environment. Copy to backend/.env (git-ignored) and fill in what you need.
# Everything is optional for local development. Restart after edits: docker compose up -d backend
# Based on JobNavigator's .env.example, adapted for this repo's docker-compose.yml.

# === Sign-in and sessions ===
# People sign in with their own email and password (POST /api/auth/sign-in); there is no shared key.
# BENCHQ_ENV defaults to production (Secure cookies, no API docs). docker-compose.yml sets development.
# BENCHQ_ENV=development
# The app's own origins: CORS, and the check that every POST/PATCH/DELETE comes from the app (CSRF).
# Set to the real https origin in production.
# ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:80
# Defaults to true in production, false otherwise.
# SESSION_COOKIE_SECURE=true
# Proxies in front of the backend that append the client's address to X-Forwarded-For (sign-in and invite rate
# limits count per address). 1 = one load balancer; 0 = trust no header and use the connecting address.
# TRUSTED_PROXY_HOPS=1

# === Logs (backend/logging_setup.py) ===
# One line per log record on stdout: JSON in production, readable text otherwise. Set either to override.
# LOG_FORMAT=json
# LOG_LEVEL=INFO

# === Password recovery links (no email is sent; approvers share links manually) ===
# Production must use the public HTTPS frontend origin. Local development defaults to http://localhost:3000.
PASSWORD_RESET_BASE_URL=

# === Optional: Anthropic / OpenAI API fallback ===
# Only used if no API key is configured in Settings > AI. Most setups set the key there instead.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# === Optional: Claude Code (uses Max/Pro subscription instead of API credits) ===
# Generate with: claude setup-token
# CLAUDE_CODE_OAUTH_TOKEN=

# === Optional: Telegram notifications (get token from @BotFather) ===
# TELEGRAM_BOT_TOKEN=

# === Optional: Gmail monitoring (one-time OAuth2 setup: python -m backend.gmail_oauth_setup) ===
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# === Optional: LM Studio (local inference, runs on the host outside the container) ===
# Docker Desktop (Mac/Windows): host.docker.internal reaches the host as-is.
# Linux: add `extra_hosts: ["host.docker.internal:host-gateway"]` to the backend service first.
# LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1

# === Database ===
# docker-compose.yml sets DATABASE_URL for the container, so leave this commented under Docker.
# Uncomment only when running uvicorn directly on your machine:
# DATABASE_URL=postgresql://jobnavigator:password@localhost:5432/jobnavigator

# Not read from this file: POSTGRES_PASSWORD (default "password") is taken by docker-compose
# from your shell. JobNavigator's JN_IMAGE_TAG doesn't apply; this repo builds its own image.

# Per-candidate Gmail (read-only); use your own Google OAuth app and a Fernet key.
CANDIDATE_GMAIL_CLIENT_ID=
CANDIDATE_GMAIL_CLIENT_SECRET=
CANDIDATE_GMAIL_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
CANDIDATE_GMAIL_ENCRYPTION_KEY=

# Keep false until PR 3, privacy protections, Google verification and owner sign-off.
CANDIDATE_GMAIL_ENABLED=false
# Encryption key setting accepts comma-separated Fernet keys: newest first, previous keys for decryption.

# PR 3: enable only after written provider/consent approval; all defaults are OFF.
CANDIDATE_EMAIL_CLASSIFICATION_ENABLED=false
CANDIDATE_EMAIL_REAL_MAIL_APPROVED=false
# Independent 30-day Other cleanup gate; evaluation must show zero job-related would-remove decisions.
CANDIDATE_EMAIL_PURGE_ENABLED=false
# PR 4: automatic status updates. Keep false until PR 4 is merged and Undo is verified (OPERATIONS.md).
CANDIDATE_EMAIL_AUTO_STATUS_ENABLED=false
CANDIDATE_EMAIL_AUTOMATION_APPROVED=false
# ISO 8601 with a time zone, e.g. 2026-11-06T12:00:00Z. Mail received earlier is never executed automatically.
CANDIDATE_EMAIL_AUTOMATION_START_AT=
# PR 4 backfills: keep false until the eligible counts were reviewed (python -m backend.inbox.backfill).
CANDIDATE_EMAIL_SETUP_RECOVERY_ENABLED=false
CANDIDATE_EMAIL_HISTORICAL_ENABLED=false
CANDIDATE_EMAIL_PURGE_EVALUATED=false
CANDIDATE_EMAIL_PURGE_EVALUATION_CONFIG_ID=
