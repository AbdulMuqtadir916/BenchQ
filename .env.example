# Frontend environment. Copy to .env.local and restart `pnpm dev` after changes.

# Where the FastAPI backend runs. Next.js proxies /api/* and /health to it. The session is the backend's, so it
# must be running: `docker compose up -d db backend`. Unset, development uses http://localhost:8000.
BACKEND_URL=http://localhost:8000

# Comma-separated modules that use the real backend; everything not listed stays on mock data.
# Names are listed in src/lib/api/config.ts, e.g. NEXT_PUBLIC_LIVE_MODULES=jobs,companies
# The session, the team, invites, /admin and the ledger are always the backend's: not listed here.
NEXT_PUBLIC_LIVE_MODULES=

# Fake delay for mock responses, in milliseconds. Optional.
NEXT_PUBLIC_MOCK_DELAY_MS=60

# Show dev-only routes (/dev/design-system, Super Admin only). The only switch: off unless exactly `true`, in `pnpm dev`
# and in a build alike. Leave unset in production.
# NEXT_PUBLIC_SHOW_DEV_ROUTES=true

# Only needed from Module 03 on. The backend has no candidates, so live applications and
# resumes are attached to this mock candidate (decision D1 in docs/integration/06-open-decisions.md).
NEXT_PUBLIC_DEFAULT_CANDIDATE_ID=cand_01


# After candidate Gmail connection is merged/configured, include inbox in NEXT_PUBLIC_LIVE_MODULES.
# Per-candidate OAuth credentials and encryption belong in backend/.env, never NEXT_PUBLIC_*.

# PR 3: enable only after written provider/consent approval; all defaults are OFF.
CANDIDATE_EMAIL_CLASSIFICATION_ENABLED=false
CANDIDATE_EMAIL_REAL_MAIL_APPROVED=false
# Independent 30-day Other cleanup gate; evaluation must show zero job-related would-remove decisions.
CANDIDATE_EMAIL_PURGE_ENABLED=false
CANDIDATE_EMAIL_PURGE_EVALUATED=false
CANDIDATE_EMAIL_PURGE_EVALUATION_CONFIG_ID=
