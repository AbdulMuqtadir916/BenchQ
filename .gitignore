# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is the committed template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python (backend/)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
/backups/
backend/.linkedin_api/

# Ruflo/claude-flow generated project files (local only, never committed)
.agents/
.claude-flow/
.swarm/
ruvector.db
agentdb.rvf
agentdb.rvf.lock
.claude/*
!.claude/launch.json
