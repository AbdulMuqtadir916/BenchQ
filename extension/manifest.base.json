{
  "manifest_version": 3,
  "name": "BenchQ Autofill Apply",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "Open saved BenchQ jobs, fill application forms from the candidate's answer bank, and track applications.",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "commands": {
    "run-autofill": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Autofill the connected job's form"
    },
    "mark-applied": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Mark the connected job applied"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open BenchQ Autofill Apply",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
